# Safe placeholders only. Never commit real values.
# All values are public (NEXT_PUBLIC_*) and optional; empty = shown as "to be confirmed".

# Canonical site URL (no trailing slash). Production: https://piano-nuggets.aurisnexus.co.za
NEXT_PUBLIC_SITE_URL=https://piano-nuggets.aurisnexus.co.za

# Official WhatsApp number in international format, digits only (TBC)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public contact email (TBC)
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional override of the studio address text (default: 4 Lang Street, Rosettenville)
NEXT_PUBLIC_STUDIO_LOCATION=
# Fresh Wind Music website URL (TBC)
NEXT_PUBLIC_FRESH_WIND_URL=

# --- Enquiry delivery (server-side secrets: set in Vercel, NEVER prefix with NEXT_PUBLIC_) ---
# Where enrolment enquiries are emailed. Falls back to NEXT_PUBLIC_CONTACT_EMAIL if unset.
ENQUIRY_TO_EMAIL=
# Sender address shown on the email (must be on a domain you have verified with your provider).
ENQUIRY_FROM_EMAIL=
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
# Option B: any SMTP mailbox (for example Zoho Mail: smtp.zoho.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true
# If neither option is configured, the form falls back to a prepared WhatsApp/email message the visitor sends themselves.
